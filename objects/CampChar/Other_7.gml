if Menu.race == race {
    if sprite_index != spr_menu {
        if sprite_index = spr_to {
            sprite_index = spr_menu
        }
		else sprite_index = spr_to
    }
}
else {
    if sprite_index != spr_slct {
        if sprite_index = spr_from {
            sprite_index = spr_slct
        }
		else sprite_index = spr_from
    }
}